# Makefile for CLISP module set rawsock

srcdir = @srcdir@
CC = @CC@
CPPFLAGS = @CPPFLAGS@
CFLAGS = @CFLAGS@
CLISP = @CLISP@ -norc -q
CLISP_LINKKIT = @CLISP_LINKKIT@

LN = @LN@
LN_S = @LN_S@

MAKE = make

SHELL = /bin/sh

GENERATED = sock.fas rawsock.@OBJEXT@ preload.lisp
DISTRIBFILES = link.sh Makefile $(GENERATED) $(srcdir)/sock.lisp
distribdir =

# default target: make the module
clisp-module : $(GENERATED)

sock.fas: $(srcdir)/sock.lisp
	$(CLISP) -c @BTHS@$(srcdir)/sock.lisp@BTHE@ -o ./

rawsock.@OBJEXT@ : rawsock.m.c config.h
	$(CC) $(CPPFLAGS) $(CFLAGS) -I. -I$(CLISP_LINKKIT) \
		-c rawsock.m.c -o rawsock.@OBJEXT@

rawsock.m.c : $(srcdir)/rawsock.c
	$(CLISP) -C @BTHS@$(CLISP_LINKKIT)/modprep@BTHE@ @BTHS@$(srcdir)/rawsock.c@BTHE@ ./

preload.lisp : $(srcdir)/preload.lisp
	$(LN) $(srcdir)/preload.lisp .

# Make a module distribution into $(distribdir)
clisp-module-distrib : clisp-module force
	$(LN) $(DISTRIBFILES) $(distribdir)
	mkdir -p $(distribdir)/demos
	$(LN) $(srcdir)/demos/*.lisp $(srcdir)/demos/README $(distribdir)/demos/

clean : force
	rm -f core *.@OBJEXT@ *.a *.m.c *.fas *.lib

distclean : clean

force :

