dnl AUTOCONF configuration for ASDF

AC_PREREQ([2.64])
AC_INIT(asdf, 1.0, clisp-list)
AC_CONFIG_SRCDIR(asdf.lisp)
AC_CONFIG_HEADERS(config.h)  dnl not needed, but this simplifies Makefile.devel

RSE_BOLD
