#
# Makefile.in for FastCGI CLISP module
#

srcdir = @srcdir@
CC = @CC@
CPPFLAGS = @CPPFLAGS@
CFLAGS = @CFLAGS@
CLISP = @CLISP@ -norc -q
CLISP_LINKKIT = @CLISP_LINKKIT@

LN = @LN@

MAKE = make

SHELL = /bin/sh

GENERATED = fastcgi.@OBJEXT@ fastcgi.fas fastcgi_wrappers.@OBJEXT@
DISTRIBFILES = link.sh Makefile $(GENERATED) \
	$(srcdir)/fastcgi.lisp $(srcdir)/README
distribdir =

# default target: make the module
clisp-module : $(GENERATED)

fastcgi.c fastcgi.fas: $(srcdir)/fastcgi.lisp
	$(CLISP) -c @BTHS@$(srcdir)/fastcgi.lisp@BTHE@ -o ./

fastcgi.@OBJEXT@: fastcgi.c
	$(CC) $(CPPFLAGS) $(CFLAGS) -I$(CLISP_LINKKIT) -I.. -c fastcgi.c

fastcgi_wrappers.@OBJEXT@: $(srcdir)/fastcgi_wrappers.c
	$(CC) $(CPPFLAGS) $(CFLAGS) -I$(CLISP_LINKKIT) -I.. -c $(srcdir)/fastcgi_wrappers.c

# Make a module distribution into $(distribdir)
clisp-module-distrib : clisp-module force
	$(LN) $(DISTRIBFILES) $(distribdir)

clean : force
	rm -f core *.@OBJEXT@ *.a *.fas *.lib

distclean : clean

force :
